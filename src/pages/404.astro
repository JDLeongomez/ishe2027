---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="wrap page page-single">
    <article class="page-body">
      <header class="page-header">
        <h1>Page not found</h1>
        <p class="lede">This address does not match any page. It may have moved while the site was being built.</p>
      </header>
      <div class="prose">
        <p><a href="/">Go to the home page</a>, or use the menu at the bottom of this page to find what you need.</p>
      </div>
    </article>
  </div>
</Base>
